{
  "name": "HealthcareClaimsAnalytics",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "SnowflakeServer",
        "kind": "m",
        "expression": "\"YOUR_ACCOUNT.snowflakecomputing.com\"",
        "annotations": [{"name": "IsParameterQuery", "value": "true"}, {"name": "Type", "value": "Text"}]
      },
      {
        "name": "SnowflakeWarehouse",
        "kind": "m",
        "expression": "\"COMPUTE_WH\"",
        "annotations": [{"name": "IsParameterQuery", "value": "true"}, {"name": "Type", "value": "Text"}]
      },
      {
        "name": "SnowflakeDatabase",
        "kind": "m",
        "expression": "\"HEALTHCARE_CLAIMS_ANALYTICS\"",
        "annotations": [{"name": "IsParameterQuery", "value": "true"}, {"name": "Type", "value": "Text"}]
      },
      {
        "name": "SnowflakeSchema",
        "kind": "m",
        "expression": "\"ANALYTICS\"",
        "annotations": [{"name": "IsParameterQuery", "value": "true"}, {"name": "Type", "value": "Text"}]
      }
    ],
    "tables": [
      {
        "name": "Date",
        "columns": [
          {"name": "Date Key", "dataType": "int64", "sourceColumn": "DATE_KEY", "formatString": "0"},
          {"name": "Date", "dataType": "dateTime", "sourceColumn": "CALENDAR_DATE", "formatString": "Short Date"},
          {"name": "Year", "dataType": "int64", "sourceColumn": "YEAR", "formatString": "0"},
          {"name": "Month Number", "dataType": "int64", "sourceColumn": "MONTH_NUMBER", "formatString": "0"},
          {"name": "Year Month", "dataType": "string", "sourceColumn": "YEAR_MONTH", "sortByColumn": "Date Key"},
          {"name": "Month Name", "dataType": "string", "sourceColumn": "MONTH_NAME", "sortByColumn": "Month Number"},
          {"name": "Quarter", "dataType": "int64", "sourceColumn": "QUARTER", "formatString": "0"}
        ],
        "partitions": [{"name": "Date", "mode": "import", "source": {"type": "m", "expression": ["let", "    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse),", "    Database = Source{[Name=SnowflakeDatabase]}[Data],", "    Schema = Database{[Name=SnowflakeSchema]}[Data],", "    Result = Schema{[Name=\"DIM_DATE\", Kind=\"Table\"]}[Data]", "in", "    Result"]}}],
        "annotations": [{"name": "PBI_ResultType", "value": "Table"}]
      },
      {
        "name": "Member",
        "columns": [
          {"name": "Member Key", "dataType": "int64", "sourceColumn": "MEMBER_KEY", "isHidden": true},
          {"name": "Beneficiary ID", "dataType": "string", "sourceColumn": "BENEFICIARY_ID"},
          {"name": "Birth Date", "dataType": "dateTime", "sourceColumn": "BIRTH_DATE", "formatString": "Short Date"},
          {"name": "Death Date", "dataType": "dateTime", "sourceColumn": "DEATH_DATE", "formatString": "Short Date"},
          {"name": "Sex", "dataType": "string", "sourceColumn": "SEX"},
          {"name": "Race", "dataType": "string", "sourceColumn": "RACE"},
          {"name": "State", "dataType": "string", "sourceColumn": "STATE"},
          {"name": "County Code", "dataType": "string", "sourceColumn": "COUNTY_CODE"},
          {"name": "ESRD Indicator", "dataType": "boolean", "sourceColumn": "ESRD_INDICATOR"}
        ],
        "partitions": [{"name": "Member", "mode": "import", "source": {"type": "m", "expression": ["let", "    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse),", "    Database = Source{[Name=SnowflakeDatabase]}[Data],", "    Schema = Database{[Name=SnowflakeSchema]}[Data],", "    Result = Schema{[Name=\"DIM_MEMBER\", Kind=\"Table\"]}[Data]", "in", "    Result"]}}]
      },
      {
        "name": "Provider",
        "columns": [
          {"name": "Provider Key", "dataType": "int64", "sourceColumn": "PROVIDER_KEY", "isHidden": true},
          {"name": "Provider ID", "dataType": "string", "sourceColumn": "PROVIDER_ID"},
          {"name": "Provider Name", "dataType": "string", "sourceColumn": "PROVIDER_NAME"},
          {"name": "Specialty", "dataType": "string", "sourceColumn": "SPECIALTY"},
          {"name": "Provider Type", "dataType": "string", "sourceColumn": "PROVIDER_TYPE"},
          {"name": "State", "dataType": "string", "sourceColumn": "STATE"}
        ],
        "partitions": [{"name": "Provider", "mode": "import", "source": {"type": "m", "expression": ["let", "    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse),", "    Database = Source{[Name=SnowflakeDatabase]}[Data],", "    Schema = Database{[Name=SnowflakeSchema]}[Data],", "    Result = Schema{[Name=\"DIM_PROVIDER\", Kind=\"Table\"]}[Data]", "in", "    Result"]}}]
      },
      {
        "name": "Claim",
        "columns": [
          {"name": "Claim Key", "dataType": "string", "sourceColumn": "CLAIM_KEY", "isHidden": true},
          {"name": "Claim ID", "dataType": "string", "sourceColumn": "CLAIM_ID"},
          {"name": "Claim Type", "dataType": "string", "sourceColumn": "CLAIM_TYPE"},
          {"name": "Service Date Key", "dataType": "int64", "sourceColumn": "SERVICE_DATE_KEY", "isHidden": true},
          {"name": "Member Key", "dataType": "int64", "sourceColumn": "MEMBER_KEY", "isHidden": true},
          {"name": "Provider Key", "dataType": "int64", "sourceColumn": "PROVIDER_KEY", "isHidden": true},
          {"name": "DRG Code", "dataType": "string", "sourceColumn": "DRG_CODE"},
          {"name": "Submitted Date", "dataType": "dateTime", "sourceColumn": "SUBMITTED_DATE", "formatString": "Short Date"},
          {"name": "Received Date", "dataType": "dateTime", "sourceColumn": "RECEIVED_DATE", "formatString": "Short Date"},
          {"name": "Adjudicated Date", "dataType": "dateTime", "sourceColumn": "ADJUDICATED_DATE", "formatString": "Short Date"},
          {"name": "Payment Date", "dataType": "dateTime", "sourceColumn": "PAYMENT_DATE", "formatString": "Short Date"},
          {"name": "Billed Amount", "dataType": "decimal", "sourceColumn": "BILLED_AMOUNT", "formatString": "$#,0.00;($#,0.00);$#,0.00"},
          {"name": "Allowed Amount", "dataType": "decimal", "sourceColumn": "ALLOWED_AMOUNT", "formatString": "$#,0.00;($#,0.00);$#,0.00"},
          {"name": "Paid Amount", "dataType": "decimal", "sourceColumn": "PAID_AMOUNT", "formatString": "$#,0.00;($#,0.00);$#,0.00"},
          {"name": "Member Responsibility", "dataType": "decimal", "sourceColumn": "MEMBER_RESPONSIBILITY_AMOUNT", "formatString": "$#,0.00;($#,0.00);$#,0.00"},
          {"name": "Adjudication Status", "dataType": "string", "sourceColumn": "ADJUDICATION_STATUS"},
          {"name": "Denial Reason Code", "dataType": "string", "sourceColumn": "DENIAL_REASON_CODE"},
          {"name": "Source Transaction", "dataType": "string", "sourceColumn": "SOURCE_TRANSACTION"},
          {"name": "Remittance Transaction", "dataType": "string", "sourceColumn": "REMITTANCE_TRANSACTION"},
          {"name": "Submission Type", "dataType": "string", "sourceColumn": "SUBMISSION_TYPE"},
          {"name": "Appeal Indicator", "dataType": "boolean", "sourceColumn": "APPEAL_INDICATOR"},
          {"name": "Injected Review Signal", "dataType": "boolean", "sourceColumn": "IS_INJECTED_SIGNAL"},
          {"name": "Injected Pattern", "dataType": "string", "sourceColumn": "INJECTED_PATTERN"},
          {"name": "Adjudication Days", "dataType": "int64", "sourceColumn": "ADJUDICATION_DAYS", "formatString": "0"}
        ],
        "measures": [
          {"name": "Total Claims", "expression": "COUNTROWS('Claim')", "formatString": "#,0"},
          {"name": "Total Billed", "expression": "SUM('Claim'[Billed Amount])", "formatString": "$#,0,,.0M"},
          {"name": "Total Allowed", "expression": "SUM('Claim'[Allowed Amount])", "formatString": "$#,0,,.0M"},
          {"name": "Total Paid", "expression": "SUM('Claim'[Paid Amount])", "formatString": "$#,0,,.0M"},
          {"name": "Member Responsibility", "expression": "SUM('Claim'[Member Responsibility])", "formatString": "$#,0,,.0M"},
          {"name": "Denied Claims", "expression": "CALCULATE([Total Claims], 'Claim'[Adjudication Status] = \"Denied\")", "formatString": "#,0"},
          {"name": "Denial Rate", "expression": "DIVIDE([Denied Claims], [Total Claims])", "formatString": "0.0%"},
          {"name": "Appealed Claims", "expression": "CALCULATE([Total Claims], 'Claim'[Appeal Indicator] = TRUE())", "formatString": "#,0"},
          {"name": "Appeal Rate", "expression": "DIVIDE([Appealed Claims], [Total Claims])", "formatString": "0.0%"},
          {"name": "Average Adjudication Days", "expression": "AVERAGE('Claim'[Adjudication Days])", "formatString": "0.0"},
          {"name": "Payment Ratio", "expression": "DIVIDE([Total Paid], [Total Billed])", "formatString": "0.0%"},
          {"name": "Review Signal Claims", "expression": "CALCULATE([Total Claims], 'Claim'[Injected Review Signal] = TRUE())", "formatString": "#,0"},
          {"name": "Review Signal Rate", "expression": "DIVIDE([Review Signal Claims], [Total Claims])", "formatString": "0.0%"},
          {"name": "Distinct Members", "expression": "DISTINCTCOUNT('Claim'[Member Key])", "formatString": "#,0"},
          {"name": "Distinct Providers", "expression": "DISTINCTCOUNT('Claim'[Provider Key])", "formatString": "#,0"},
          {"name": "Paid per Claim", "expression": "DIVIDE([Total Paid], [Total Claims])", "formatString": "$#,0"}
        ],
        "partitions": [{"name": "Claim", "mode": "import", "source": {"type": "m", "expression": ["let", "    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse),", "    Database = Source{[Name=SnowflakeDatabase]}[Data],", "    Schema = Database{[Name=SnowflakeSchema]}[Data],", "    Result = Schema{[Name=\"FACT_CLAIM\", Kind=\"Table\"]}[Data]", "in", "    Result"]}}]
      }
    ],
    "relationships": [
      {"name": "Claim_Date", "fromTable": "Claim", "fromColumn": "Service Date Key", "toTable": "Date", "toColumn": "Date Key"},
      {"name": "Claim_Member", "fromTable": "Claim", "fromColumn": "Member Key", "toTable": "Member", "toColumn": "Member Key"},
      {"name": "Claim_Provider", "fromTable": "Claim", "fromColumn": "Provider Key", "toTable": "Provider", "toColumn": "Provider Key"}
    ],
    "annotations": [
      {"name": "PBI_QueryOrder", "value": "[\"SnowflakeServer\",\"SnowflakeWarehouse\",\"SnowflakeDatabase\",\"SnowflakeSchema\",\"Date\",\"Member\",\"Provider\",\"Claim\"]"},
      {"name": "PBI_ProTooling", "value": "[\"DevMode\"]"}
    ]
  }
}
