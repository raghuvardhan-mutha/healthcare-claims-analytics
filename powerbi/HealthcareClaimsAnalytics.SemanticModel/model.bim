                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"specialty\", type text}}),",
                "    Selected = Table.SelectColumns(Typed, {\"specialty\"}),",
                "    DistinctRows = Table.Distinct(Selected)",
                "in",
                "    DistinctRows"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim Claim Status",
        "columns": [
          {
            "name": "Claim Status",
            "dataType": "string",
            "sourceColumn": "claim_status"
          }
        ],
        "partitions": [
