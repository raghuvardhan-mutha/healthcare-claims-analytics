                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"provider_id\", type text}, {\"provider_name\", type text}, {\"specialty\", type text}}),",
                "    Selected = Table.SelectColumns(Typed, {\"provider_id\", \"provider_name\", \"specialty\"}),",
                "    DistinctRows = Table.Distinct(Selected, {\"provider_id\"})",
                "in",
                "    DistinctRows"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim Specialty",
        "columns": [
